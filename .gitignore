# reference clones (not part of the repo)
.refs/

# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# secrets / local state
.env
.env.local
*.local.json
# NOTE: `state/` is the backup snapshot dir and MUST stay unignored.
# `milo backup` writes the brain there and `git push` ships it to GitHub.
# If you are tempted to ignore it, the backup stops leaving the machine.
# The snapshot is leak-scanned before every push (env.template has empty
# values; env.real only appears in offline .tar.gz archives).
logs/
*.log

# os
.DS_Store
Thumbs.db

# Superseded v1 layout. These were replaced by the miloctl package in 2.0
# and keep reappearing when an old working copy is pushed by hand; ignoring
# them means a stale checkout can't silently resurrect a second, divergent
# implementation of the same system.
/milo/
/milo.py
/MANIFEST.json
/.env.template
