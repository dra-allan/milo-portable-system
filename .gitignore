# reference clones (not part of the repo)
.refs/

# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# secrets / local state
.env
.env.local
*.local.json
# NOTE: `state/` is the backup snapshot dir and MUST stay unignored.
# `milo backup` writes the brain there and `git push` ships it to GitHub.
# If you are tempted to ignore it, the backup stops leaving the machine.
# The snapshot is leak-scanned before every push (env.template has empty
# values; env.real only appears in offline .tar.gz archives).
logs/
*.log

# os
.DS_Store
Thumbs.db

# Superseded v1 layout. These were replaced by the miloctl package in 2.0
# and keep reappearing when an old working copy is pushed by hand; ignoring
# them means a stale checkout can't silently resurrect a second, divergent
# implementation of the same system.
/milo/
/milo.py
/MANIFEST.json
/.env.template

# pip build artifacts
build/

# Shorts pipeline local working data. Downloaded videos, rendered clips, the
# media-library index and the SQLite tracking DB are machine-local state, not
# source. Committing them would push gigabytes of video and leak which
# channels were processed.
artisan/youtube-shorts-pipeline/data/temp/
artisan/youtube-shorts-pipeline/data/shorts/
artisan/youtube-shorts-pipeline/data/logs/
artisan/youtube-shorts-pipeline/data/transcripts/
artisan/youtube-shorts-pipeline/data/library.json
artisan/youtube-shorts-pipeline/data/*.db
artisan/youtube-shorts-pipeline/config/.env
artisan/youtube-shorts-pipeline/config/youtube_token.json

# Long-form pipeline render scratch + outputs
artisan/mm_pipeline/**/_work/
artisan/mm_pipeline/**/*_FINAL.mp4
artisan/mm_pipeline/**/*_FINAL.wav
artisan/mm_pipeline/**/media_cache/

# pov_pipeline audio artifacts (generated narration files)
artisan/pov_pipeline/**/06_AUDIO/
