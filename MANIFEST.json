{
  "name": "Milo Portable System",
  "version": "1.0.0",
  "description": "Universal Milo deployment \u2014 clone, run, done.",
  "repos": {
    "milo": "https://github.com/dra-allan/milo.git",
    "agentmemory": "https://github.com/dra-allan/agentmemory-milo.git",
    "dra-brains": "https://github.com/dra-allan/dra-brains.git",
    "milo-portable": "https://github.com/dra-allan/milo-portable-system.git"
  },
  "services": {
    "MiloServe": "opencode serve --port 4096",
    "MiloBot": "python agentmemory-milo/milo-bot/src/bot.py"
  },
  "python_deps": [
    "python-telegram-bot",
    "httpx",
    "requests"
  ],
  "secrets_required": [
    "TELEGRAM_BOT_TOKEN",
    "ALLOWED_USER_IDS",
    "GITHUB_PAT"
  ],
  "secrets_optional": [
    "SUPABASE_URL",
    "SUPABASE_SERVICE_ROLE_KEY",
    "SUPABASE_ANON_KEY",
    "ANTHROPIC_API_KEY",
    "OPENAI_API_KEY"
  ]
}