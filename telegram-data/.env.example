# Milo Telegram Bot — environment template.
# Copy to `.env` and fill in real values, then source from `scripts/run.sh`.

# Required
TELEGRAM_BOT_TOKEN=__FILL_ME_FROM_BOTFATHER__

# Comma-separated Telegram numeric user IDs allowed to talk to Milo.
# Get yours from @userinfobot. Leave blank during testing only.
ALLOWED_USER_IDS=

# Opencode CLI bridge
OPENCODE_BIN=opencode
OPENCODE_WORKDIR=/tmp  # Change to your preferred workspace directory
OPENCODE_TIMEOUT_SEC=600
MILO_AGENT=milo

# Local fallback memory (used when ENGRAM_API_KEY is not set)
# For portable SQLite version, we'll use the database in data/memories.db
MILO_DB_PATH=${MILO_HOME:-$HOME/.milo-portable}/data/memories.db

# Logs
LOG_LEVEL=INFO

# Webhook mode (optional - using long polling by default)
# WEBHOOK_URL=
# WEBHOOK_PATH=/milo
# PORT=8080
