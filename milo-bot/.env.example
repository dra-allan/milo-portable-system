# --- Milo Telegram bot -------------------------------------------------------
# Copy to .env (this file is the template; .env is gitignored).
# The bot also reads %LOCALAPPDATA%\milo\.env and the repo .env, so keys can
# live in one place. Ambient environment always wins over files.

# --- required ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=            # @BotFather
TELEGRAM_CHAT_ID=              # @userinfobot - where pipelines report
ALLOWED_USER_IDS=              # comma separated; EMPTY = bot refuses to start

# --- fast path (instant plain-text replies) ---------------------------------
# Any OpenAI-compatible endpoint. Without a key the bot still works, it just
# routes plain text through opencode (slower).
NVIDIA_API_KEY=
MILO_FAST_BASE_URL=https://integrate.api.nvidia.com/v1
MILO_FAST_MODEL=nvidia/nvidia-nemotron-nano-9b-v2
MILO_FAST_MAX_TOKENS=700
MILO_FAST_TEMPERATURE=0.6
MILO_FAST_TIMEOUT_SEC=45

# --- agent path (/do, agent mode) ------------------------------------------
OPENCODE_BIN=opencode                          # full path if not on PATH
OPENCODE_WORKDIR=C:\milo-portable-system
OPENCODE_SERVER_URL=http://127.0.0.1:4096      # the MiloOpencodeServer daemon
OPENCODE_TIMEOUT_SEC=600
MILO_AGENT=milo
OPENCODE_MODEL=

# --- paths -----------------------------------------------------------------
MILO_HOME=%LOCALAPPDATA%\milo
MILO_VAULT_DIR=C:\Users\Administrator\Desktop\dra-brains
MILO_DB_PATH=
LOG_LEVEL=INFO
