# Milo Telegram Bot — environment template.
# Copy to `.env` and fill in real values, then source from `scripts/run.sh`.

# Required
TELEGRAM_BOT_TOKEN=__FILL_ME_FROM_BOTFATHER__

# Comma-separated Telegram numeric user IDs allowed to talk to Milo.
# Get yours from @userinfobot. Leave blank during testing only.
ALLOWED_USER_IDS=

# Opencode CLI bridge
OPENCODE_BIN=opencode
OPENCODE_WORKDIR=/root/projects
# OPENCODE_MODEL=anthropic/claude-sonnet-4-5      # optional, overrides opencode.json
OPENCODE_TIMEOUT_SEC=600
MILO_AGENT=milo

# Local fallback memory (Engram is the production store once ENGRAM_API_KEY is set)
MILO_DB_PATH=/root/.milo/milo-bot.sqlite

# Logs
LOG_LEVEL=INFO

# Webhook mode (optional)
# WEBHOOK_URL=
# WEBHOOK_PATH=/milo
# PORT=8080
