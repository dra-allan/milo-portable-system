# Milo Telegram Bot - environment template.
# Copy to `.env` next to this file and fill in real values. The bot loads it at
# startup; anything already in the real environment wins.

# ---- required ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=__FILL_ME_FROM_BOTFATHER__
# Where unsolicited reports land (pipelines, watchdog, daily digest).
TELEGRAM_CHAT_ID=
# Comma-separated Telegram numeric user ids allowed to command Milo.
# Get yours from @userinfobot. EMPTY = the bot refuses to start (fail closed).
ALLOWED_USER_IDS=

# ---- fast path (plain-text chat, ~1-2s, no tools) ---------------------------
# Any OpenAI-compatible endpoint works; NVIDIA NIM is the default.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
MILO_FAST_HISTORY_TURNS=10
MILO_FAST_MAX_TOKENS=900
MILO_FAST_TIMEOUT_SEC=45

# ---- agent path (/ask, !prefix - full tools, persistent session) ------------
# The bot talks HTTP to a warm `opencode serve`. It never spawns `opencode run`
# per message: that was the "new session every message" bug and the 3-minute
# replies. Started by scripts/vps/Install-MiloDaemons.ps1 as Milo-OpencodeServer.
OPENCODE_SERVER_URL=http://127.0.0.1:4096
# OPENCODE_SERVER_PASSWORD=          # only if you set it on the server
# OPENCODE_SERVER_USERNAME=opencode
OPENCODE_WORKDIR=C:\milo-portable-system
MILO_AGENT=milo
# OPENCODE_MODEL=                    # optional, overrides opencode config
OPENCODE_TIMEOUT_SEC=900
# MILO_BOT_SHOW_TOOLS=1              # append the tool trace to agent replies

# ---- paths ------------------------------------------------------------------
MILO_HOME=C:\Users\Administrator\AppData\Local\milo
MILO_VAULT_DIR=C:\Users\Administrator\Desktop\dra-brains
# MILO_DB_PATH=                      # defaults to <MILO_HOME>\memory.db

# ---- misc -------------------------------------------------------------------
LOG_LEVEL=INFO
MILO_BOT_LOCK_PORT=47431
