# YouTube API Configuration
YOUTUBE_API_KEY=your_youtube_data_api_key_here
# OR for OAuth (uncomment and set path):
# GOOGLE_APPLICATION_CREDENTIALS=path/to/credentials.json

# Processing Settings
MAX_CONCURRENT_VIDEOS=3
MIN_SEGMENT_LENGTH=15
MAX_SEGMENT_LENGTH=60
# How many clips to actually render per source video.
MAX_CLIPS_PER_VIDEO=5
# How deep to rank and remember candidates. Rendering more clips later
# ("--render-more") reuses this plan: no re-download, no re-transcribe.
MAX_CANDIDATES=30
# TEMP_DIR=./data/temp
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# SPEED: transcription (was ~85% of total runtime)
# ---------------------------------------------------------------------------
# Pass 1 "discovery" -- only used to FIND highlights, so it runs fast and
# cheap. tiny + greedy beam + no word timestamps is 10-20x faster than the
# old hardcoded base + beam=5 + word_timestamps, and it does not OOM.
TRANSCRIBE_MODEL=tiny
TRANSCRIBE_BEAM=1
TRANSCRIBE_WORD_TIMESTAMPS=false
TRANSCRIBE_VAD=true
# 0 = whole source (recommended: more source = more clips).
# Set e.g. 20 to only scan the first 20 minutes for a fast discovery run.
TRANSCRIBE_MAX_MINUTES=0
# Memory guard for long files. faster-whisper builds a full-file mel array,
# so audio longer than this is processed in windows. Lower it if you OOM.
TRANSCRIBE_WINDOW_MINUTES=15
# CPU threads for whisper. 0 = let ctranslate2 decide.
TRANSCRIBE_THREADS=0

# Pass 2 "caption" -- runs ONLY on the selected clips (a few minutes of audio
# total), so it can afford accuracy + word-level timing.
TWO_PASS_CAPTIONS=true
CAPTION_MODEL=base
CAPTION_BEAM=5

# ---------------------------------------------------------------------------
# SPEED: downloading (no more pulling a 2 GB file to use 5 minutes of it)
# ---------------------------------------------------------------------------
# Discovery fetch grabs audio only: ~40 MB for an hour instead of 1-2 GB.
DOWNLOAD_AUDIO_ONLY=true
# Then fetch ONLY the chosen clip ranges as small files (yt-dlp
# --download-sections) instead of the whole video.
DOWNLOAD_SECTIONS=true
# Seconds of slack fetched around each clip. Absorbs keyframe drift and lets
# you nudge timings later without re-downloading.
SECTION_PADDING=8
DOWNLOAD_HEIGHT=1080
# Section fetches that run in parallel with rendering (network vs CPU).
DOWNLOAD_CONCURRENCY=2

# ---------------------------------------------------------------------------
# SPEED: rendering
# ---------------------------------------------------------------------------
# Parallel ffmpeg encodes. Leave unset: the default scales with your core
# count (1 on a 2-core box). Measured speedup from forcing 2 workers on 2
# cores is only 1.02-1.06x, because libx264 already uses every core -- see
# BENCHMARKS.md. Raise this only if you have spare cores.
# RENDER_WORKERS=2
# Backdrop fill behind the vertical video.
#   cheap = blurred backdrop, blurred at low resolution then scaled up.
#           SSIM 0.975 vs the full-res blur, filter stage 3.07x faster --
#           this was the single most expensive operation in the pipeline.
#   blur  = original full-resolution gaussian blur (slow, reference look)
#   black = flat black bars (fastest overall, 2.01x)
#   crop  = fill the frame by cropping the sides (no bars, loses edges)
BACKGROUND_MODE=cheap
VIDEO_PRESET=veryfast
VIDEO_CRF=23

# Scheduling (cron-like format for apscheduler)
RUN_TIMES=0 9 * * *,0 14 * * *,0 19 * * *  # 9AM, 2PM, 7PM

# When the daily stats refresh (feedback loop) runs; only used in --mode schedule
STATS_RUN_TIME=0 8 * * *  # 8AM daily

# ---------------------------------------------------------------------------
# Working data lives OUTSIDE the milo portable folder so downloads, temp
# files, rendered Shorts and logs never bloat the repo. Copy this block into
# config/.env (which is gitignored) and set real absolute paths on this
# machine. Relative values resolve against the pipeline project root.
# ---------------------------------------------------------------------------
# DATA_DIR={{SHORTS_DATA_DIR}}/data
# TEMP_DIR={{SHORTS_DATA_DIR}}/temp
# SHORTS_DIR={{SHORTS_DATA_DIR}}/shorts
# LOG_DIR={{SHORTS_DATA_DIR}}/logs
# DB_PATH={{SHORTS_DATA_DIR}}/data/processed_videos.db
