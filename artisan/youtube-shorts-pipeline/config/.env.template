# YouTube API Configuration
YOUTUBE_API_KEY=your_youtube_data_api_key_here
# OR for OAuth (uncomment and set path):
# GOOGLE_APPLICATION_CREDENTIALS=path/to/credentials.json

# Processing Settings
MAX_CONCURRENT_VIDEOS=3
MIN_SEGMENT_LENGTH=15
MAX_SEGMENT_LENGTH=60
# How many clips to actually render per source video.
MAX_CLIPS_PER_VIDEO=5
# Cap for sources the feedback loop has proven (avg views >= WINNER_AVG_VIEWS):
# a winning channel gets more clips per pull because the download/transcribe is
# already paid for. New/unproven sources stay at MAX_CLIPS_PER_VIDEO.
MAX_CLIPS_PER_VIDEO_WINNER=8
# Avg views (across recorded clips) that marks a source as a proven winner.
WINNER_AVG_VIEWS=200
# How deep to rank and remember candidates (also the real render cap per source).
# The planner picks the TOP 12 segments per source; --render-more later reuses
# this plan with no re-download / no re-transcribe.
MAX_CANDIDATES=12

# ---------------------------------------------------------------------------
# SINGLE OUTPUT ROOT FOR ALL PIPELINES
# Set this ONCE on each machine. All pipelines derive their paths from it.
# Example: VIDEO_FACTORY_ROOT=C:\Users\user\Desktop\Milo Video Factory
# ---------------------------------------------------------------------------
VIDEO_FACTORY_ROOT=C:/Users/user/Desktop/Milo Video Factory

# ---------------------------------------------------------------------------
# PATHS (derived from VIDEO_FACTORY_ROOT - override individually if needed)
# ---------------------------------------------------------------------------
SHORTS_DIR={{VIDEO_FACTORY_ROOT}}
# ---------------------------------------------------------------------------
TRANSCRIBE_MODEL=tiny
TRANSCRIBE_BEAM=1
TRANSCRIBE_WORD_TIMESTAMPS=false
TRANSCRIBE_VAD=true
TRANSCRIBE_MAX_MINUTES=0
TRANSCRIBE_WINDOW_MINUTES=15
TRANSCRIBE_THREADS=0

TWO_PASS_CAPTIONS=true
CAPTION_MODEL=base
CAPTION_BEAM=5

# ---------------------------------------------------------------------------
# SPEED: downloading
# ---------------------------------------------------------------------------
DOWNLOAD_AUDIO_ONLY=true
DOWNLOAD_SECTIONS=true
SECTION_PADDING=8
DOWNLOAD_HEIGHT=1080
DOWNLOAD_CONCURRENCY=2

# ---------------------------------------------------------------------------
# SPEED: rendering
# ---------------------------------------------------------------------------
RENDER_WORKERS=auto
BACKGROUND_MODE=cheap
VIDEO_PRESET=veryfast
VIDEO_CRF=23

# ---------------------------------------------------------------------------
# PATHS (derived from VIDEO_FACTORY_ROOT - override individually if needed)
# ---------------------------------------------------------------------------
# DATA_DIR={{VIDEO_FACTORY_ROOT}}\shorts\data
# TEMP_DIR={{VIDEO_FACTORY_ROOT}}\shorts\temp
# SHORTS_DIR={{VIDEO_FACTORY_ROOT}}\shorts\shorts
# LOG_DIR={{VIDEO_FACTORY_ROOT}}\shorts\logs
# DB_PATH={{VIDEO_FACTORY_ROOT}}\shorts\data\processed_videos.db

# POV pipeline
# POV_SCRIPTS_DIR={{VIDEO_FACTORY_ROOT}}\pov\scripts
# POV_TTS_DIR={{VIDEO_FACTORY_ROOT}}\pov\tts
# POV_ASSEMBLER_DIR={{VIDEO_FACTORY_ROOT}}\pov\assembler
# POV_OUTPUT_DIR={{VIDEO_FACTORY_ROOT}}\projects

# MM pipeline
# MM_OUTPUT_DIR={{VIDEO_FACTORY_ROOT}}\projects

# Scheduling (cron-like format for apscheduler)
RUN_TIMES=0 9 * * *  # 9AM daily (once per day)
STATS_RUN_TIME=0 8 * * *  # 8AM daily

# ---------------------------------------------------------------------------
# UPLOAD ROUTING (niche -> channel) and throttling
# ---------------------------------------------------------------------------
# Each niche in config/niches.yaml can declare `upload_channels: [<name>, ...]`
# to publish to those channels' tokens (config/youtube_token_<name>.json). The
# legacy `channel: <name>` single binding still works. Run this once per channel
# before uploading:  python -m src.uploader auth --channel <name>
UPLOAD_ENABLED=true
PRIVACY_STATUS=public
# Run raw clip hooks through the rule-based title optimizer (curiosity-gap
# headlines) when generating Short titles. off => raw hook is used verbatim.
TITLE_OPTIMIZER=true
# Hard cap on uploads per run (YouTube quota ~6 uploads/day/project).
UPLOAD_MAX_PER_RUN=5
# Fill unused cap with older rendered-but-unpublished clips.
UPLOAD_BACKLOG=true
# Channel used when a niche has no `upload_channels:`/`channel:` binding.
# Empty = require binding.
UPLOAD_DEFAULT_CHANNEL=
# How to distribute a niche's clips among its upload_channels. round_robin
# (default) alternates per clip; 'all' uploads every clip to every channel;
# 'first' uses only the first (legacy behaviour).
MULTICHANNEL_UPLOAD_MODE=round_robin

# SCHEDULED DISCOVERY
# ---------------------------------------------------------------------------
# Global cap on how many videos a single scheduled sweep may start (across all
# niches). The sweep stops once this is exhausted so 20+ unbound niches can't
# trigger 20 download cycles.
SCHEDULE_MAX_VIDEOS=3
# Candidate pool size pulled per source channel during discovery. Must be >=
# the per-niche max_videos value so the top-N filter has enough to choose from.
DISCOVERY_LOOKBACK=10
# Hard ceiling on videos started across ALL niches in one sweep (0 = unlimited).
SCHEDULE_MAX_TOTAL=6
# Pull-once model: if a niche still has un-uploaded clips, a sweep posts those
# instead of downloading another source video. Only pulls a new video when the
# clip supply runs out (morning pull -> post all day -> re-pull only when empty).
# This is what turns "3 downloads a day" into "1 download, posted all day".
SCHEDULE_BACKLOG_FIRST=true
# A niche's clip supply is "exhausted" when fewer than this many clips remain.
# Default 1 = pull a new video only when nothing is left to post. Raise it to
# re-pull while some clips remain posted.
SCHEDULE_BACKLOG_MIN=1
# Random minute-offset applied to each scheduled run time (0 = exact times).
SCHEDULE_JITTER_MINUTES=45
# Random delay in seconds between uploads in a run (anti-burst). 0 = disabled.
UPLOAD_PACING_MIN=45
UPLOAD_PACING_MAX=180
