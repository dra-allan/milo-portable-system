# YouTube API Configuration
YOUTUBE_API_KEY=your_youtube_data_api_key_here
# OR for OAuth (uncomment and set path):
# GOOGLE_APPLICATION_CREDENTIALS=path/to/credentials.json

# Processing Settings
MAX_CONCURRENT_VIDEOS=3
MIN_SEGMENT_LENGTH=15
MAX_SEGMENT_LENGTH=60
# How many clips to actually render per source video.
MAX_CLIPS_PER_VIDEO=5
# How deep to rank and remember candidates. Rendering more clips later
# ("--render-more") reuses this plan: no re-download, no re-transcribe.
MAX_CANDIDATES=30

# ---------------------------------------------------------------------------
# SINGLE OUTPUT ROOT FOR ALL PIPELINES
# Set this ONCE on each machine. All pipelines derive their paths from it.
# Example: VIDEO_FACTORY_ROOT=C:\Users\user\Desktop\Milo Video Factory
# ---------------------------------------------------------------------------
VIDEO_FACTORY_ROOT={{VIDEO_FACTORY_ROOT}}

# ---------------------------------------------------------------------------
# SPEED: transcription (was ~85% of total runtime)
# ---------------------------------------------------------------------------
TRANSCRIBE_MODEL=tiny
TRANSCRIBE_BEAM=1
TRANSCRIBE_WORD_TIMESTAMPS=false
TRANSCRIBE_VAD=true
TRANSCRIBE_MAX_MINUTES=0
TRANSCRIBE_WINDOW_MINUTES=15
TRANSCRIBE_THREADS=0

TWO_PASS_CAPTIONS=true
CAPTION_MODEL=base
CAPTION_BEAM=5

# ---------------------------------------------------------------------------
# SPEED: downloading
# ---------------------------------------------------------------------------
DOWNLOAD_AUDIO_ONLY=true
DOWNLOAD_SECTIONS=true
SECTION_PADDING=8
DOWNLOAD_HEIGHT=1080
DOWNLOAD_CONCURRENCY=2

# ---------------------------------------------------------------------------
# SPEED: rendering
# ---------------------------------------------------------------------------
RENDER_WORKERS=auto
BACKGROUND_MODE=cheap
VIDEO_PRESET=veryfast
VIDEO_CRF=23

# ---------------------------------------------------------------------------
# PATHS (derived from VIDEO_FACTORY_ROOT — override individually if needed)
# ---------------------------------------------------------------------------
# DATA_DIR={{VIDEO_FACTORY_ROOT}}\shorts\data
# TEMP_DIR={{VIDEO_FACTORY_ROOT}}\shorts\temp
# SHORTS_DIR={{VIDEO_FACTORY_ROOT}}\shorts\shorts
# LOG_DIR={{VIDEO_FACTORY_ROOT}}\shorts\logs
# DB_PATH={{VIDEO_FACTORY_ROOT}}\shorts\data\processed_videos.db

# POV pipeline
# POV_SCRIPTS_DIR={{VIDEO_FACTORY_ROOT}}\pov\scripts
# POV_TTS_DIR={{VIDEO_FACTORY_ROOT}}\pov\tts
# POV_ASSEMBLER_DIR={{VIDEO_FACTORY_ROOT}}\pov\assembler
# POV_OUTPUT_DIR={{VIDEO_FACTORY_ROOT}}\projects

# MM pipeline
# MM_OUTPUT_DIR={{VIDEO_FACTORY_ROOT}}\projects

# Scheduling (cron-like format for apscheduler)
RUN_TIMES=0 9 * * *,0 14 * * *,0 19 * * *  # 9AM, 2PM, 7PM
STATS_RUN_TIME=0 8 * * *  # 8AM daily
