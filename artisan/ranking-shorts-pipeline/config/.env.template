# Ranking Shorts pipeline environment. Never commit config/.env.
VIDEO_FACTORY_ROOT=

# Voice-over
GEMINI_API_KEYS=
RANKING_TTS_VOICE=Puck
RANKING_TTS_FORMAT=mp3
VO_ENABLED=true
VO_SKIP_FIRST=true

# Script writing
GEMINI_API_KEY=
SCRIPT_MODEL=gemini-2.5-flash

# Upload
RANKING_OAUTH_CLIENT_SECRETS=./credentials.json
RANKING_OAUTH_TOKEN_FILE=config/youtube_token_ranking.json
UPLOAD_PRIVACY=private
UPLOAD_MAX_PER_RUN=1
UPLOAD_MAX_PER_CHANNEL=6

# Render: veryfast is intentional; quality is still controlled by CRF 18.
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_CRF=18
VIDEO_PRESET=veryfast
VIDEO_ENCODER=auto
OVERLAY_FONT=C:/Windows/Fonts/impact.ttf

# Runtime paths: relative values resolve outside the repo.
DATA_DIR=data
TEMP_DIR=temp
OUTPUT_DIR=output
SFX_DIR=assets/sfx
MUSIC_DIR=assets/music

# Download guardrails. Vetting copies never exceed these limits.
# 720p is enough for motion/OCR vetting and avoids pulling 1080p/4K originals.
RANKING_DOWNLOAD_HEIGHT=720
RANKING_MAX_DOWNLOAD_MB=250
RANKING_DOWNLOAD_CONCURRENCY=4
RANKING_MAX_SOURCE_SECONDS=900
RANKING_RENDER_TIMEOUT=900

LOG_LEVEL=INFO
CLIPS_PER_VIDEO=5
DRY_RUN=false
