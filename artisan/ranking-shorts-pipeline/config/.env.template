# ---------------------------------------------------------------------------
# Ranking Shorts pipeline - environment
# Copy to config/.env and fill in.
# This file is INDEPENDENT of the youtube-shorts-pipeline .env on purpose:
# the two pipelines must never share state, tokens or output directories.
# ---------------------------------------------------------------------------

# --- Voice-over (forked Gemini TTS) ---------------------------------------
# Comma-separated keys are rotated round-robin, same as the original TTS.
GEMINI_API_KEYS=
RANKING_TTS_VOICE=Puck
RANKING_TTS_FORMAT=mp3
VO_ENABLED=true
# Rank 5 opens the video; its clip is usually too short for a line (see the
# reference workflow). Set to false to voice every clip.
VO_SKIP_FIRST=true

# --- Script writing --------------------------------------------------------
# Optional. With a key, clip titles and VO lines are written by the model from
# what the vetting pass saw. Without one, the template writer is used.
GEMINI_API_KEY=
SCRIPT_MODEL=gemini-2.5-flash

# --- Upload ----------------------------------------------------------------
# Own OAuth client + own token files. Tokens land in config/ as
# youtube_token_ranking_<channel>.json so they cannot collide with the
# shorts pipeline's tokens.
RANKING_OAUTH_CLIENT_SECRETS=./credentials.json
RANKING_OAUTH_TOKEN_FILE=./config/youtube_token_ranking.json
UPLOAD_PRIVACY=private
UPLOAD_MAX_PER_RUN=1

# --- Render ----------------------------------------------------------------
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_CRF=18
VIDEO_PRESET=medium
# auto | off | nvenc | qsv | amf | videotoolbox
VIDEO_ENCODER=auto

# Font used for every overlay. A heavy display face is what sells the look.
# Windows: C:/Windows/Fonts/impact.ttf
# Linux:   /usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
OVERLAY_FONT=C:/Windows/Fonts/impact.ttf

# --- Paths -----------------------------------------------------------------
DATA_DIR=./data
TEMP_DIR=./data/temp
OUTPUT_DIR=./data/output
SFX_DIR=./assets/sfx
MUSIC_DIR=./assets/music

# --- Behaviour -------------------------------------------------------------
LOG_LEVEL=INFO
CLIPS_PER_VIDEO=5
DRY_RUN=false
