# ---------------------------------------------------------------------------
# Ranking Shorts pipeline - environment
# Copy to config/.env and fill in. Never commit config/.env.
# Code stays in GitHub; runtime files stay outside the checkout.
# ---------------------------------------------------------------------------

# Shared parent used by the other video pipelines. The ranking pipeline writes
# to <VIDEO_FACTORY_ROOT>/ranking-shorts-pipeline/.
VIDEO_FACTORY_ROOT=

# --- Voice-over (forked Gemini TTS) ---------------------------------------
GEMINI_API_KEYS=
RANKING_TTS_VOICE=Puck
RANKING_TTS_FORMAT=mp3
VO_ENABLED=true
VO_SKIP_FIRST=true

# --- Script writing --------------------------------------------------------
GEMINI_API_KEY=
SCRIPT_MODEL=gemini-2.5-flash

# --- Upload ----------------------------------------------------------------
RANKING_OAUTH_CLIENT_SECRETS=./credentials.json
# Relative paths resolve inside the external ranking runtime root.
RANKING_OAUTH_TOKEN_FILE=config/youtube_token_ranking.json
UPLOAD_PRIVACY=private
UPLOAD_MAX_PER_RUN=1

# --- Render ----------------------------------------------------------------
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_CRF=18
VIDEO_PRESET=medium
# auto | off | nvenc | qsv | amf | videotoolbox
VIDEO_ENCODER=auto
OVERLAY_FONT=C:/Windows/Fonts/impact.ttf

# --- Paths -----------------------------------------------------------------
# Relative values resolve under <VIDEO_FACTORY_ROOT>/ranking-shorts-pipeline/.
DATA_DIR=data
TEMP_DIR=temp
OUTPUT_DIR=output
# Assets are code/deployment inputs and remain in the checkout by default.
SFX_DIR=assets/sfx
MUSIC_DIR=assets/music

# --- Behaviour -------------------------------------------------------------
LOG_LEVEL=INFO
CLIPS_PER_VIDEO=5
DRY_RUN=false
