# Ranking Shorts pipeline environment. Never commit config/.env.
VIDEO_FACTORY_ROOT=

# Voice-over
GEMINI_API_KEYS=
RANKING_TTS_VOICE=Puck
RANKING_TTS_FORMAT=mp3
VO_ENABLED=true
VO_SKIP_FIRST=true

# Script writing
GEMINI_API_KEY=
SCRIPT_MODEL=gemini-2.5-flash

# Upload
RANKING_OAUTH_CLIENT_SECRETS=./credentials.json
RANKING_OAUTH_TOKEN_FILE=config/youtube_token_ranking.json
UPLOAD_PRIVACY=public
UPLOAD_MAX_PER_RUN=6
UPLOAD_MAX_PER_CHANNEL=6

# Scheduling / caps (mirrors youtube-shorts-pipeline)
# UPLOAD_MAX_PER_DAY is the hard 24h ceiling every path honours.
UPLOAD_MAX_PER_DAY=6
# Target ready-pool size; a sweep only builds to refill toward this.
QUEUE_TARGET_TOTAL=12
# Of the per-run uploads, how many may come from fresh vs backlog.
SWEEP_FRESH_SHARE=3
SWEEP_BACKLOG_SHARE=3
# Cron list (comma-separated 5-field crons) used by --mode schedule.
RUN_TIMES=0 9 * * *
# Random minute offset added to each cron to avoid the :00 cliff.
SCHEDULE_JITTER_MINUTES=0

# Render: veryfast is intentional; quality is still controlled by CRF 18.
# Output resolution: Shorts are vertical 9:16. 1080x1920 = 1080p (standard).
# 2160x3840 = 4K. Must maintain 9:16 (width*16 == height*9).
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_CRF=18
VIDEO_PRESET=veryfast
VIDEO_ENCODER=auto
OVERLAY_FONT=C:/Windows/Fonts/impact.ttf

# Runtime paths: relative values resolve outside the repo.
DATA_DIR=data
TEMP_DIR=temp
OUTPUT_DIR=output
SFX_DIR=assets/sfx
MUSIC_DIR=assets/music

# Download guardrails. Vetting copies never exceed these limits.
# 2160 enables 4K source downloads when available; falls through to best available.
RANKING_DOWNLOAD_HEIGHT=2160
RANKING_MAX_DOWNLOAD_MB=250
RANKING_DOWNLOAD_CONCURRENCY=4
RANKING_MAX_SOURCE_SECONDS=900
RANKING_RENDER_TIMEOUT=900

LOG_LEVEL=INFO
CLIPS_PER_VIDEO=5
DRY_RUN=false
