# Copy to config/.env and edit. NEVER commit the real file.

# ---------------------------------------------------------------------------
# Runtime location. Point this at the SAME parent the other video lanes use so
# all pipelines share one external runtime tree and none of them write inside
# the git checkout.
# ---------------------------------------------------------------------------
VIDEO_FACTORY_ROOT=

# Shared FFmpeg. Use the same binary as the Shorts and ranking lanes: a
# different build produces different output for identical config.
MILO_FFMPEG=
MILO_FFPROBE=

# An installed bold .ttf. Rendering cannot start without one.
OVERLAY_FONT=
EMOJI_FONT=C:/Windows/Fonts/seguiemj.ttf

# ---------------------------------------------------------------------------
# Copy model. Optional: without a key the pipeline uses template hooks, which
# is duller but never blocks a build. Required caption tokens are enforced in
# code either way, so a missing key can never cause a compliance failure.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
SCRIPT_MODEL=gemini-flash-latest

# ---------------------------------------------------------------------------
# Content folder download. rclone is preferred for big folders; gdown needs no
# setup at all. One of the two must be available.
# ---------------------------------------------------------------------------
RCLONE_REMOTE=
GDOWN_BIN=gdown

# ---------------------------------------------------------------------------
# Publishing. Leave these exactly as they are until you have watched a full
# campaign pass validation and reviewed the file yourself.
# ---------------------------------------------------------------------------
CLIPPER_UPLOAD_CHANNEL=
UPLOAD_PRIVACY=private
CLIPPER_AUTO_UPLOAD=false
CLIPPER_AUTO_SUBMIT=false
CLIPPER_MAX_PER_DAY=5
CLIPPER_MAX_PER_CAMPAIGN_PER_DAY=3

# ---------------------------------------------------------------------------
# Campaign board. Headless is off on purpose: you log in by hand once and the
# persistent profile keeps the session. The pipeline never handles a password.
# ---------------------------------------------------------------------------
CLIPSTER_BASE=https://clipster.gg
CLIPSTER_HEADLESS=false

# ---------------------------------------------------------------------------
# Render. CRF 18 / preset medium is a measured setting, not a guess: veryfast
# reintroduces blocking beside hard caption edges and the platform re-encode
# preserves those blocks rather than hiding them.
# ---------------------------------------------------------------------------
VIDEO_CRF=18
VIDEO_PRESET=medium
VIDEO_ENCODER=auto
CLIPS_PER_RUN=3
CLIPS_PER_SOURCE=2
TARGET_DURATION=22

LOG_LEVEL=INFO
DRY_RUN=false
