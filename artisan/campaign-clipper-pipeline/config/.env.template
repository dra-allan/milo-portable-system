# Copy to config/.env and edit. NEVER commit the real file.\n\nVIDEO_FACTORY_ROOT=\nMILO_FFMPEG=\nMILO_FFPROBE=\nOVERLAY_FONT=\nEMOJI_FONT=C:/Windows/Fonts/seguiemj.ttf\n\nGEMINI_API_KEY=\nSCRIPT_MODEL=gemini-flash-latest\n\nRCLONE_REMOTE=\nGDOWN_BIN=gdown\n\nCLIPPER_UPLOAD_CHANNEL=\nUPLOAD_PRIVACY=private\nCLIPPER_AUTO_UPLOAD=false\nCLIPPER_AUTO_SUBMIT=false\nCLIPPER_MAX_PER_DAY=5\nCLIPPER_MAX_PER_CAMPAIGN_PER_DAY=3\n\nCLIPSTER_BASE=https://clipster.gg\nCLIPSTER_HEADLESS=false\n\nVIDEO_CRF=18\nVIDEO_PRESET=medium\nVIDEO_ENCODER=auto\nCLIPS_PER_RUN=3\nCLIPS_PER_SOURCE=2\nTARGET_DURATION=22\n\n# Framing: real full 9:16 crop, never a blurred background.\n# Face detection keeps a streamer or a two-person conversation in frame.\n# If detection fails, the pipeline uses a centre crop automatically.\nCLIPPER_SMART_CROP=true\nCLIPPER_SMART_SAMPLES=9\n\nLOG_LEVEL=INFO\nDRY_RUN=false\n