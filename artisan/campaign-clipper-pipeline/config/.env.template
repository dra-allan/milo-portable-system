# Copy to config/.env and edit. NEVER commit the real file.

VIDEO_FACTORY_ROOT=
MILO_FFMPEG=
MILO_FFPROBE=
OVERLAY_FONT=
EMOJI_FONT=C:/Windows/Fonts/seguiemj.ttf

# Automatic highlight ranking. One Whisper transcript per source, cached.
# Word-level timestamps are captured too; they drive the burned captions.
HIGHLIGHT_WHISPER=true
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1
WHISPER_LANGUAGE=
HIGHLIGHT_SETUP_SECONDS=8

# Viral word-by-word captions burned into the clip, same engine/presets as the
# Shorts lane. Style: viral | hormozi | kinetic | single | minimalist | neon.
CAPTIONS_ENABLED=true
CAPTION_STYLE=viral
# CAPTION_FONT_SIZE=
# CAPTION_MAX_WORDS=
# CAPTION_PUNCH_RATIO=0.22

GEMINI_API_KEY=
SCRIPT_MODEL=gemini-flash-latest

RCLONE_REMOTE=
GDOWN_BIN=gdown

CLIPPER_UPLOAD_CHANNEL=
UPLOAD_PRIVACY=private
CLIPPER_AUTO_UPLOAD=false
CLIPPER_AUTO_SUBMIT=false
CLIPPER_MAX_PER_DAY=5
CLIPPER_MAX_PER_CAMPAIGN_PER_DAY=3

CLIPSTER_BASE=https://clipster.gg
CLIPSTER_HEADLESS=false

VIDEO_CRF=18
VIDEO_PRESET=medium
VIDEO_ENCODER=auto
CLIPS_PER_RUN=3
CLIPS_PER_SOURCE=2
TARGET_DURATION=22

# Full 9:16 crop. No blurred background.
CLIPPER_SMART_CROP=true
YOLO_MODEL_PATH=yolov8n.pt
YOLO_PERSON_CONF=0.35
YOLO_IMAGE_SIZE=640
YOLO_SAMPLES=9
YOLO_MIN_PRESENCE=0.34
YOLO_MAX_PERSONS=8
YOLO_MAX_SUBJECTS=2
YOLO_SINGLE_ZOOM=0.82
YOLO_PAIR_WIDE_RATIO=0.42
YOLO_TRACK_TOLERANCE=0.18

LOG_LEVEL=INFO
DRY_RUN=false
